{
  "manifest_version": 3,
  "name": "Трекер времени",
  "version": "1.0.0",
  "description": "Учёт времени по проектам с Google Таблицами",
  "permissions": [
    "storage",
    "alarms",
    "identity"
  ],
  "host_permissions": [
    "https://sheets.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/idle-16.png",
    "32": "icons/idle-32.png",
    "48": "icons/idle-48.png",
    "128": "icons/idle-128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Трекер времени",
    "default_icon": {
      "16": "icons/idle-16.png",
      "32": "icons/idle-32.png"
    }
  },
  "oauth2": {
    "client_id": "174396585638-cdvc5etn1ffjjshbsgqtu8oe5dfhd4h0.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets"
    ]
  }
}
